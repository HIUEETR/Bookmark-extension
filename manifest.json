{
  "name": "My Bookmark",
  "short_name": "MyBookmark",
  "version": "1.0.0",
  "description": "Multi-column bookmark manager with drag & drop and undo support",
  "manifest_version": 3,
  "background": {
    "service_worker": "background.js"
  },
  "action": {},
  "permissions": [
    "bookmarks",
    "storage"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}